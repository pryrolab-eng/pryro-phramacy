# =============================================================================
# Pryrox — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit your .env file to version control.
# See docs/environment-variables.md for full descriptions of each variable.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# Required for all database, authentication, and realtime functionality.
# Find these values in your Supabase project dashboard under Settings > API.
# -----------------------------------------------------------------------------

# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Preferred: publishable key (Dashboard → Settings → API). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional fallback: legacy anon JWT from the same project (omit if publishable is set).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase service role key — SERVER ONLY, never expose to the browser
# This key bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# -----------------------------------------------------------------------------
# Application
# Base URL of the running application. Used in KPay callback URLs and
# internal server-to-server fetch calls.
# -----------------------------------------------------------------------------

# Public base URL of the application (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal base URL used by some API routes (typically the same as APP_URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Secret for Vercel cron / manual calls to /api/cron/subscription-transitions
# (Authorization: Bearer <CRON_SECRET> or x-cron-secret header)
CRON_SECRET=your-random-cron-secret-here


# -----------------------------------------------------------------------------
# KPay Payment Gateway
# Credentials for the KPay mobile money / card payment integration.
# Obtain these from your KPay merchant account at pay.esicia.com.
# -----------------------------------------------------------------------------

# KPay API base URL (default: https://pay.esicia.com)
KPAY_BASE_URL=https://pay.esicia.com

# KPay merchant username
KPAY_USERNAME=your-kpay-username

# KPay merchant password
KPAY_PASSWORD=your-kpay-password

# KPay retailer identifier assigned to your merchant account
KPAY_RETAILER_ID=your-kpay-retailer-id

# (Optional) Webhook URL for KPay payment callbacks
# Defaults to: ${NEXT_PUBLIC_APP_URL}/api/kpay/webhook
KPAY_RETURN_URL=https://your-app.example.com/api/kpay/webhook

# (Optional) URL to redirect the customer after a successful payment
# Defaults to: ${NEXT_PUBLIC_APP_URL}/payment/success
KPAY_REDIRECT_URL=https://your-app.example.com/payment/success


# -----------------------------------------------------------------------------
# Polar (card / international subscriptions)
# Paid plans auto-sync to Polar when created/updated in Admin → Subscriptions.
# Webhook URL: https://your-app.example.com/api/polar/webhook
# -----------------------------------------------------------------------------

POLAR_ACCESS_TOKEN=polar_pat_...
POLAR_WEBHOOK_SECRET=whsec_...
# sandbox (default) or production
POLAR_SERVER=sandbox
# Checkout currency on Polar (usd recommended; RWF prices converted using rate below)
POLAR_CHECKOUT_CURRENCY=usd
# RWF per 1 USD for converting plan prices to Polar amounts (tune to your FX)
POLAR_RWF_PER_USD=1300
# Optional prefix for Polar product names (leave empty to use the plan name from admin as-is)
# POLAR_PRODUCT_NAME_PREFIX=Pryrox 


# -----------------------------------------------------------------------------
# SMTP fallback (Nodemailer)
# Used automatically when Supabase auth email rate limit is exceeded.
# Sign-up confirmation and password reset links are sent via this SMTP server.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Pryrox <noreply@your-domain.com>"
# Set to "true" for port 465 (implicit TLS)
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Polar Payment (https://polar.sh)
# Used for subscription billing. Get your access token from polar.sh/settings.
# Use sandbox for development, production for live.
# -----------------------------------------------------------------------------

# Organization access token from polar.sh/settings
POLAR_ACCESS_TOKEN=your-polar-access-token

# Webhook secret from polar.sh/settings → Webhooks → Add Endpoint
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Product IDs from polar.sh → Products → Copy Product ID
NEXT_PUBLIC_POLAR_PRODUCT_ID_STARTER=your-starter-product-id
NEXT_PUBLIC_POLAR_PRODUCT_ID_GROWTH=your-growth-product-id
NEXT_PUBLIC_POLAR_PRODUCT_ID_ENTERPRISE=your-enterprise-product-id


# -----------------------------------------------------------------------------
# Subscription Lifecycle Cron
# Used to authenticate the daily cron job that checks for expired subscriptions,
# sends warning emails, and resets monthly usage counters.
#
# Set this to any long random string (e.g. openssl rand -hex 32).
# Add the same value in Vercel Dashboard → Settings → Environment Variables.
# Vercel Cron will automatically send it as: Authorization: Bearer <value>
# -----------------------------------------------------------------------------

CRON_SECRET=your-random-cron-secret-here
