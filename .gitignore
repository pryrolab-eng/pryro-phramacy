# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local uploads (logos, platform reports)
/uploads

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
dev*.log

# local scratch / one-off dumps (do not commit)
/scratch/
/admin*.html
/signin_resp.html
/admin_headers.txt
/admin_session_cookie.txt
/make_session.cjs
/check_*.js
/check_*.sql
/add_*.sql
/baseline.sql

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Tempo

node_modules/
**/tempobook/dynamic/
**/tempobook/storyboards/

# remove git history
.git/*

.github/
# Node modules backup
node_modules_backup/
.kiro/*
.vscode/*
.cursor/*